rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Pillar 0: Global Default-Deny Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Primitive Helpers
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isVerifiedUser() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isVerifiedUser() && (
        request.auth.token.email == '360aparicio@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        (
          exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' &&
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.planActive == true
        )
      );
    }

    function isValidPlanPermissions(perms) {
      return perms is map
        && perms.keys().hasAll(['labPro', 'webBrain', 'unlimitedEval', 'pdfExport'])
        && perms.keys().hasOnly(['labPro', 'webBrain', 'unlimitedEval', 'pdfExport', 'planAdmin'])
        && perms.labPro is bool
        && perms.webBrain is bool
        && perms.unlimitedEval is bool
        && perms.pdfExport is bool
        && (!perms.keys().hasAny(['planAdmin']) || perms.planAdmin is bool);
    }

    function isValidEmailKey(inviteId) {
      return isVerifiedUser()
        && request.auth.token.email is string
        && inviteId == ('inv_' + request.auth.token.email.lower().replace('[^a-zA-Z0-9_\\-]', '_'));
    }

    function hasValidInviteForCaller() {
      return isVerifiedUser()
        && request.auth.token.email is string
        && exists(/databases/$(database)/documents/userInvites/$( 'inv_' + request.auth.token.email.lower().replace('[^a-zA-Z0-9_\\-]', '_') ))
        && get(/databases/$(database)/documents/userInvites/$( 'inv_' + request.auth.token.email.lower().replace('[^a-zA-Z0-9_\\-]', '_') )).data.status == 'pending'
        && get(/databases/$(database)/documents/userInvites/$( 'inv_' + request.auth.token.email.lower().replace('[^a-zA-Z0-9_\\-]', '_') )).data.email == request.auth.token.email.lower();
    }

    function matchesCallerInvite(data) {
      return hasValidInviteForCaller()
        && data.role == get(/databases/$(database)/documents/userInvites/$( 'inv_' + request.auth.token.email.lower().replace('[^a-zA-Z0-9_\\-]', '_') )).data.role
        && data.planTier == get(/databases/$(database)/documents/userInvites/$( 'inv_' + request.auth.token.email.lower().replace('[^a-zA-Z0-9_\\-]', '_') )).data.planTier
        && data.planActive == get(/databases/$(database)/documents/userInvites/$( 'inv_' + request.auth.token.email.lower().replace('[^a-zA-Z0-9_\\-]', '_') )).data.planActive
        && (!data.keys().hasAny(['planPermissions']) || data.planPermissions == get(/databases/$(database)/documents/userInvites/$( 'inv_' + request.auth.token.email.lower().replace('[^a-zA-Z0-9_\\-]', '_') )).data.planPermissions);
    }

    // Validation Blueprint: UserProfile
    function isValidUserProfile(data, userId) {
      return data.keys().hasAll([
        'uid', 'email', 'displayName', 'role', 'planTier', 'planActive',
        'elo', 'masteryScore', 'totalDecisions', 'totalMistakes',
        'roadmapDoneIds', 'categoryStats', 'evaluationStats', 'createdAt', 'updatedAt'
      ])
      && data.keys().hasOnly([
        'uid', 'email', 'displayName', 'photoURL', 'role', 'planTier', 'planActive', 'planPermissions',
        'isManualPlaceholder', 'elo', 'masteryScore', 'totalDecisions', 'totalMistakes',
        'roadmapDoneIds', 'categoryStats', 'evaluationStats',
        'studyLevel', 'studyLevelSource', 'marketStudyEnrolled', 'deckTheme',
        'createdAt', 'updatedAt'
      ])
      && data.uid is string && data.uid.size() >= 6 && data.uid.size() <= 128 && data.uid == userId
      && data.email is string && data.email.size() >= 3 && data.email.size() <= 160
      && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 80
      && (!data.keys().hasAny(['photoURL']) || (data.photoURL is string && data.photoURL.size() <= 512))
      && (!data.keys().hasAny(['planPermissions']) || isValidPlanPermissions(data.planPermissions))
      && (!data.keys().hasAny(['isManualPlaceholder']) || data.isManualPlaceholder is bool)
      && (!data.keys().hasAny(['studyLevel']) || data.studyLevel in ['fish', 'reg', 'nit'])
      && (!data.keys().hasAny(['studyLevelSource']) || data.studyLevelSource in ['self_selected', 'cohort_assignment', 'admin_override'])
      && (!data.keys().hasAny(['marketStudyEnrolled']) || data.marketStudyEnrolled is bool)
      && (!data.keys().hasAny(['deckTheme']) || data.deckTheme in ['classic_white', 'four_color_white', 'dark_pro', 'four_color_dark'])
      && data.role in ['user', 'admin']
      && data.planTier in ['free', 'pro', 'elite']
      && data.planActive is bool
      && data.elo is number && data.elo >= 0 && data.elo <= 5000
      && data.masteryScore is number && data.masteryScore >= 0 && data.masteryScore <= 100
      && data.totalDecisions is number && data.totalDecisions >= 0
      && data.totalMistakes is number && data.totalMistakes >= 0
      && data.roadmapDoneIds is list && data.roadmapDoneIds.size() <= 32
      && (data.roadmapDoneIds.size() == 0 || (data.roadmapDoneIds[0] is string && data.roadmapDoneIds[0].size() <= 32))
      && data.categoryStats is map
      && data.evaluationStats is map
      && data.createdAt is timestamp
      && data.updatedAt is timestamp;
    }

    // Validation Blueprint: UserInvite
    function isValidUserInvite(data) {
      return data.keys().hasAll([
        'email', 'displayName', 'role', 'planTier', 'planActive', 'planPermissions',
        'status', 'manualUserDocId', 'createdByUid', 'createdAt', 'updatedAt'
      ])
      && data.keys().hasOnly([
        'email', 'displayName', 'role', 'planTier', 'planActive', 'planPermissions',
        'status', 'manualUserDocId', 'createdByUid', 'claimedUid', 'createdAt', 'updatedAt'
      ])
      && data.email is string && data.email.size() >= 3 && data.email.size() <= 160
      && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 80
      && data.role in ['user', 'admin']
      && data.planTier in ['free', 'pro', 'elite']
      && data.planActive is bool
      && isValidPlanPermissions(data.planPermissions)
      && data.status in ['pending', 'claimed']
      && data.manualUserDocId is string && data.manualUserDocId.size() >= 6 && data.manualUserDocId.size() <= 128
      && data.createdByUid is string && data.createdByUid.size() >= 6 && data.createdByUid.size() <= 128
      && (!data.keys().hasAny(['claimedUid']) || (data.claimedUid is string && data.claimedUid.size() >= 6 && data.claimedUid.size() <= 128))
      && data.createdAt is timestamp
      && data.updatedAt is timestamp;
    }

    // Validation Blueprint: SM2ItemRecord
    function isValidSM2Item(data, userId) {
      return data.keys().hasAll([
        'ownerId', 'itemType', 'title', 'category', 'prompt', 'explanation',
        'rule', 'intervalDays', 'repetitions', 'easeFactor', 'nextReviewDate',
        'reviewCount', 'createdAt', 'updatedAt'
      ])
      && data.keys().hasOnly([
        'ownerId', 'itemType', 'title', 'category', 'prompt', 'explanation',
        'rule', 'intervalDays', 'repetitions', 'easeFactor', 'nextReviewDate',
        'reviewCount', 'createdAt', 'updatedAt'
      ])
      && data.ownerId is string && data.ownerId.size() >= 6 && data.ownerId.size() <= 128
      && data.ownerId == request.auth.uid && data.ownerId == userId
      && data.itemType in ['concept', 'hand', 'scenario']
      && data.title is string && data.title.size() >= 1 && data.title.size() <= 160
      && data.category is string && data.category.size() >= 1 && data.category.size() <= 80
      && data.prompt is string && data.prompt.size() <= 600
      && data.explanation is string && data.explanation.size() <= 1200
      && data.rule is string && data.rule.size() <= 600
      && data.intervalDays is number && data.intervalDays >= 0 && data.intervalDays <= 3650
      && data.repetitions is number && data.repetitions >= 0 && data.repetitions <= 500
      && data.easeFactor is number && data.easeFactor >= 1.3 && data.easeFactor <= 5.0
      && data.nextReviewDate is number && data.nextReviewDate >= 0
      && data.reviewCount is number && data.reviewCount >= 0
      && data.createdAt is timestamp
      && data.updatedAt is timestamp;
    }

    // Validation Blueprint: MistakeRecord
    function isValidMistakeRecord(data, userId) {
      return data.keys().hasAll([
        'ownerId', 'scenarioTitle', 'heroCombo', 'wetness',
        'evLossPercentOfPot', 'chosenAction', 'bestAction', 'prescriptiveFix', 'createdAt'
      ])
      && data.keys().hasOnly([
        'ownerId', 'scenarioTitle', 'heroCombo', 'wetness',
        'evLossPercentOfPot', 'chosenAction', 'bestAction', 'prescriptiveFix', 'createdAt'
      ])
      && data.ownerId is string && data.ownerId.size() >= 6 && data.ownerId.size() <= 128
      && data.ownerId == request.auth.uid && data.ownerId == userId
      && data.scenarioTitle is string && data.scenarioTitle.size() >= 1 && data.scenarioTitle.size() <= 160
      && data.heroCombo is string && data.heroCombo.size() >= 2 && data.heroCombo.size() <= 16
      && data.wetness is string && data.wetness.size() >= 1 && data.wetness.size() <= 48
      && data.evLossPercentOfPot is number && data.evLossPercentOfPot >= 0 && data.evLossPercentOfPot <= 500
      && data.chosenAction is string && data.chosenAction.size() >= 1 && data.chosenAction.size() <= 80
      && data.bestAction is string && data.bestAction.size() >= 1 && data.bestAction.size() <= 80
      && data.prescriptiveFix is string && data.prescriptiveFix.size() >= 1 && data.prescriptiveFix.size() <= 600
      && data.createdAt is timestamp;
    }

    // Admin lookup collection (read-only for owner)
    match /admins/{adminId} {
      allow get: if isValidId(adminId) && isOwner(adminId);
      allow list, write: if false;
    }

    // Admin-provisioned manual user invitations
    match /userInvites/{inviteId} {
      allow get: if isValidId(inviteId) && (isAdmin() || (isValidEmailKey(inviteId) && existing().email == request.auth.token.email.lower()));
      allow list: if isAdmin();
      allow create: if isValidId(inviteId)
        && isAdmin()
        && isValidUserInvite(incoming())
        && incoming().createdByUid == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(inviteId)
        && isValidUserInvite(incoming())
        && incoming().email == existing().email
        && incoming().createdByUid == existing().createdByUid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          isAdmin() || (
            isValidEmailKey(inviteId)
            && existing().status == 'pending'
            && incoming().status == 'claimed'
            && incoming().claimedUid == request.auth.uid
            && incoming().role == existing().role
            && incoming().planTier == existing().planTier
            && incoming().planActive == existing().planActive
            && incoming().planPermissions == existing().planPermissions
            && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'claimedUid', 'updatedAt'])
          )
        );
      allow delete: if isValidId(inviteId) && isAdmin();
    }

    // Match User Profile Collection
    match /users/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isAdmin() || (isVerifiedUser() && existing().uid == request.auth.uid);

      allow create: if isValidId(userId)
        && isValidUserProfile(incoming(), userId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && (
          isAdmin()
          || (
            isOwner(userId)
            && incoming().uid == request.auth.uid
            && !incoming().keys().hasAny(['isManualPlaceholder'])
            && (
              matchesCallerInvite(incoming())
              || (
                incoming().role == 'user'
                && incoming().planTier == 'free'
                && incoming().planActive == true
                && !incoming().keys().hasAny(['planPermissions'])
              )
            )
          )
        );

      allow update: if isValidId(userId)
        && isValidUserProfile(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          // Normal strict V3.2/V3.4 updates (existing doc already has RBAC/plan fields)
          (
            existing().keys().hasAll(['email', 'role', 'planTier', 'planActive', 'evaluationStats'])
            && incoming().email == existing().email
            && (
              // Tier 1: Admin can manage planTier, planActive, planPermissions, role & metrics
              (
                isAdmin()
                && incoming().diff(existing()).affectedKeys().hasOnly([
                  'displayName', 'photoURL', 'role', 'planTier', 'planActive', 'planPermissions',
                  'isManualPlaceholder', 'elo', 'masteryScore', 'totalDecisions', 'totalMistakes',
                  'roadmapDoneIds', 'categoryStats', 'evaluationStats',
                  'studyLevel', 'studyLevelSource', 'marketStudyEnrolled', 'deckTheme', 'updatedAt'
                ])
              )
              ||
              // Tier 2: Owner can ONLY update own study metrics (cannot forge plan, permissions or role)
              (
                isOwner(userId)
                && incoming().role == existing().role
                && incoming().planTier == existing().planTier
                && incoming().planActive == existing().planActive
                && incoming().diff(existing()).affectedKeys().hasOnly([
                  'displayName', 'photoURL', 'elo', 'masteryScore', 'totalDecisions',
                  'totalMistakes', 'roadmapDoneIds', 'categoryStats', 'evaluationStats',
                  'studyLevel', 'studyLevelSource', 'marketStudyEnrolled', 'deckTheme', 'updatedAt'
                ])
              )
            )
          )
          ||
          // Safe one-time migration from legacy V3.1 docs missing V3.2 RBAC/plan fields
          (
            !existing().keys().hasAll(['email', 'role', 'planTier', 'planActive', 'evaluationStats'])
            && isOwner(userId)
            && incoming().role == (isAdmin() ? 'admin' : 'user')
            && incoming().planTier == (isAdmin() ? 'elite' : 'free')
            && incoming().planActive == true
          )
        );

      allow delete: if isValidId(userId) && (isOwner(userId) || isAdmin());

      // Subcollection: SM-2 Items
      match /sm2Items/{itemId} {
        allow get: if isValidId(userId) && isValidId(itemId) && (isOwner(userId) || isAdmin());
        allow list: if isAdmin() || (isVerifiedUser() && existing().ownerId == request.auth.uid);

        allow create: if isValidId(userId) && isValidId(itemId)
          && isOwner(userId)
          && exists(/databases/$(database)/documents/users/$(userId))
          && isValidSM2Item(incoming(), userId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time;

        allow update: if isValidId(userId) && isValidId(itemId)
          && isOwner(userId)
          && exists(/databases/$(database)/documents/users/$(userId))
          && isValidSM2Item(incoming(), userId)
          && incoming().ownerId == existing().ownerId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'title', 'category', 'prompt', 'explanation', 'rule',
            'intervalDays', 'repetitions', 'easeFactor', 'nextReviewDate',
            'reviewCount', 'updatedAt'
          ]);

        allow delete: if isValidId(userId) && isValidId(itemId) && (isOwner(userId) || isAdmin());
      }

      // Subcollection: Mistakes (>5% EV)
      match /mistakes/{mistakeId} {
        allow get: if isValidId(userId) && isValidId(mistakeId) && (isOwner(userId) || isAdmin());
        allow list: if isAdmin() || (isVerifiedUser() && existing().ownerId == request.auth.uid);

        allow create: if isValidId(userId) && isValidId(mistakeId)
          && isOwner(userId)
          && exists(/databases/$(database)/documents/users/$(userId))
          && isValidMistakeRecord(incoming(), userId)
          && incoming().createdAt == request.time;

        allow update: if false;
        allow delete: if isValidId(userId) && isValidId(mistakeId) && (isOwner(userId) || isAdmin());
      }
    }

    // Validation Blueprint: AdminAuditLog
    function isValidAdminAuditLog(data) {
      return data.keys().hasAll([
        'actorUid', 'actorEmail', 'targetUid', 'targetLabel', 'action', 'detail', 'createdAt'
      ])
      && data.keys().hasOnly([
        'actorUid', 'actorEmail', 'targetUid', 'targetLabel', 'action', 'detail', 'createdAt'
      ])
      && data.actorUid is string && data.actorUid.size() >= 6 && data.actorUid.size() <= 128
      && data.actorEmail is string && data.actorEmail.size() >= 3 && data.actorEmail.size() <= 160
      && data.targetUid is string && data.targetUid.size() >= 6 && data.targetUid.size() <= 128
      && data.targetLabel is string && data.targetLabel.size() >= 1 && data.targetLabel.size() <= 160
      && data.action is string && data.action.size() >= 2 && data.action.size() <= 64
      && data.detail is string && data.detail.size() >= 1 && data.detail.size() <= 300
      && data.createdAt is timestamp;
    }

    // Immutable Admin Audit Log Collection
    match /adminAuditLogs/{logId} {
      allow get, list: if isAdmin();
      allow create: if isValidId(logId)
        && isAdmin()
        && isValidAdminAuditLog(incoming())
        && incoming().actorUid == request.auth.uid
        && incoming().createdAt == request.time;
      allow update, delete: if false;
    }

    function isValidVisibleSections(sec) {
      return sec is map
        && sec.keys().hasAll([
          'wizard', 'solver', 'trainer', 'cheatsheet', 'academy',
          'solver_meta', 'ranges', 'scenarios', 'benchmarks'
        ])
        && sec.keys().hasOnly([
          'wizard', 'solver', 'trainer', 'cheatsheet', 'academy',
          'solver_meta', 'ranges', 'scenarios', 'benchmarks'
        ])
        && sec.wizard is bool
        && sec.solver is bool
        && sec.trainer is bool
        && sec.cheatsheet is bool
        && sec.academy is bool
        && sec.solver_meta is bool
        && sec.ranges is bool
        && sec.scenarios is bool
        && sec.benchmarks is bool;
    }

    function isValidPlanConfig(data, tier) {
      return data.keys().hasAll([
        'planTier', 'displayName', 'tagline', 'priceLabel',
        'maxDailyEvaluations', 'hideLockedSections', 'visibleSections',
        'defaultPermissions', 'benefits', 'updatedByUid', 'updatedAt'
      ])
      && data.keys().hasOnly([
        'planTier', 'displayName', 'tagline', 'priceLabel',
        'maxDailyEvaluations', 'hideLockedSections', 'visibleSections',
        'defaultPermissions', 'benefits', 'updatedByUid', 'updatedAt'
      ])
      && tier in ['free', 'pro', 'elite']
      && data.planTier == tier
      && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 48
      && data.tagline is string && data.tagline.size() <= 160
      && data.priceLabel is string && data.priceLabel.size() >= 1 && data.priceLabel.size() <= 32
      && data.maxDailyEvaluations is number && data.maxDailyEvaluations >= 0 && data.maxDailyEvaluations <= 1000
      && data.hideLockedSections is bool
      && isValidVisibleSections(data.visibleSections)
      && isValidPlanPermissions(data.defaultPermissions)
      && data.benefits is list && data.benefits.size() <= 15
      && (data.benefits.size() == 0 || (data.benefits[0] is string && data.benefits[0].size() <= 140))
      && data.updatedByUid is string && data.updatedByUid.size() >= 6 && data.updatedByUid.size() <= 128
      && data.updatedAt is timestamp;
    }

    // Shared Plan Catalog (Admin writes, verified Educational Lab users read)
    match /planConfigs/{planTier} {
      allow get: if isValidId(planTier) && planTier in ['free', 'pro', 'elite'] && isVerifiedUser();
      allow list: if isVerifiedUser() && existing().planTier in ['free', 'pro', 'elite'];
      allow create, update: if isValidId(planTier)
        && isAdmin()
        && isValidPlanConfig(incoming(), planTier)
        && incoming().updatedByUid == request.auth.uid
        && incoming().updatedAt == request.time;
      allow delete: if isValidId(planTier) && isAdmin();
    }

    // Validation Blueprint: BillingTransaction
    function isValidBillingTransaction(data) {
      return data.keys().hasAll([
        'userUid', 'userEmail', 'userName', 'planTier', 'amountUsd', 'currency',
        'paymentMethod', 'status', 'billingPeriod', 'referenceCode', 'notes',
        'recordedByUid', 'createdAt', 'updatedAt'
      ])
      && data.keys().hasOnly([
        'userUid', 'userEmail', 'userName', 'planTier', 'amountUsd', 'currency',
        'paymentMethod', 'status', 'billingPeriod', 'referenceCode', 'notes',
        'recordedByUid', 'createdAt', 'updatedAt'
      ])
      && data.userUid is string && data.userUid.size() >= 4 && data.userUid.size() <= 128
      && data.userEmail is string && data.userEmail.size() >= 3 && data.userEmail.size() <= 160
      && data.userName is string && data.userName.size() >= 1 && data.userName.size() <= 80
      && data.planTier in ['free', 'pro', 'elite']
      && data.amountUsd is number && data.amountUsd >= 0 && data.amountUsd <= 100000
      && data.currency == 'USD'
      && data.paymentMethod in ['Stripe', 'Transferencia', 'PayPal', 'Efectivo', 'Cortesía']
      && data.status in ['paid', 'pending', 'refunded']
      && data.billingPeriod is string && data.billingPeriod.size() >= 7 && data.billingPeriod.size() <= 16
      && data.referenceCode is string && data.referenceCode.size() <= 64
      && data.notes is string && data.notes.size() <= 240
      && data.recordedByUid is string && data.recordedByUid.size() >= 6 && data.recordedByUid.size() <= 128
      && data.createdAt is timestamp
      && data.updatedAt is timestamp;
    }

    match /billingTransactions/{txId} {
      allow get: if isValidId(txId) && (isAdmin() || (isVerifiedUser() && existing().userUid == request.auth.uid));
      allow list: if isAdmin() || (isVerifiedUser() && existing().userUid == request.auth.uid);
      allow create: if isValidId(txId)
        && isAdmin()
        && isValidBillingTransaction(incoming())
        && incoming().recordedByUid == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(txId)
        && isAdmin()
        && isValidBillingTransaction(incoming())
        && incoming().userUid == existing().userUid
        && incoming().recordedByUid == existing().recordedByUid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'notes', 'referenceCode', 'paymentMethod', 'updatedAt']);
      allow delete: if false;
    }

    // Validation Blueprint: PlatformAnnouncement
    function isValidPlatformAnnouncement(data) {
      return data.keys().hasAll([
        'title', 'message', 'severity', 'targetPlan', 'active',
        'createdByUid', 'createdAt', 'updatedAt'
      ])
      && data.keys().hasOnly([
        'title', 'message', 'severity', 'targetPlan', 'active',
        'createdByUid', 'createdAt', 'updatedAt'
      ])
      && data.title is string && data.title.size() >= 2 && data.title.size() <= 90
      && data.message is string && data.message.size() >= 4 && data.message.size() <= 300
      && data.severity in ['info', 'success', 'warning']
      && data.targetPlan in ['all', 'free', 'pro', 'elite']
      && data.active is bool
      && data.createdByUid is string && data.createdByUid.size() >= 6 && data.createdByUid.size() <= 128
      && data.createdAt is timestamp
      && data.updatedAt is timestamp;
    }

    match /platformAnnouncements/{annId} {
      allow get: if isValidId(annId) && (isAdmin() || (isVerifiedUser() && existing().active == true));
      allow list: if isAdmin() || (isVerifiedUser() && existing().active == true);
      allow create: if isValidId(annId)
        && isAdmin()
        && isValidPlatformAnnouncement(incoming())
        && incoming().createdByUid == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(annId)
        && isAdmin()
        && isValidPlatformAnnouncement(incoming())
        && incoming().createdByUid == existing().createdByUid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time;
      allow delete: if isValidId(annId) && isAdmin();
    }

    // Validation Blueprint: SupportTicket
    function isValidSupportTicket(data) {
      return data.keys().hasAll([
        'userUid', 'userEmail', 'userName', 'subject', 'description',
        'category', 'priority', 'status', 'adminNotes', 'createdByUid',
        'createdAt', 'updatedAt'
      ])
      && data.keys().hasOnly([
        'userUid', 'userEmail', 'userName', 'subject', 'description',
        'category', 'priority', 'status', 'adminNotes', 'createdByUid',
        'createdAt', 'updatedAt'
      ])
      && data.userUid is string && data.userUid.size() >= 4 && data.userUid.size() <= 128
      && data.userEmail is string && data.userEmail.size() >= 3 && data.userEmail.size() <= 160
      && data.userName is string && data.userName.size() >= 1 && data.userName.size() <= 80
      && data.subject is string && data.subject.size() >= 2 && data.subject.size() <= 120
      && data.description is string && data.description.size() >= 4 && data.description.size() <= 600
      && data.category in ['Acceso', 'Pagos', 'Duda Técnica', 'Otro']
      && data.priority in ['low', 'medium', 'high']
      && data.status in ['open', 'in_progress', 'resolved']
      && data.adminNotes is string && data.adminNotes.size() <= 400
      && data.createdByUid is string && data.createdByUid.size() >= 6 && data.createdByUid.size() <= 128
      && data.createdAt is timestamp
      && data.updatedAt is timestamp;
    }

    match /supportTickets/{ticketId} {
      allow get: if isValidId(ticketId) && (isAdmin() || (isVerifiedUser() && existing().userUid == request.auth.uid));
      allow list: if isAdmin() || (isVerifiedUser() && existing().userUid == request.auth.uid);
      allow create: if isValidId(ticketId)
        && isValidSupportTicket(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && (
          (isAdmin() && incoming().createdByUid == request.auth.uid)
          || (
            isVerifiedUser()
            && incoming().userUid == request.auth.uid
            && incoming().createdByUid == request.auth.uid
            && incoming().status == 'open'
            && incoming().adminNotes == ''
          )
        );
      allow update: if isValidId(ticketId)
        && isAdmin()
        && isValidSupportTicket(incoming())
        && incoming().userUid == existing().userUid
        && incoming().createdByUid == existing().createdByUid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'priority', 'adminNotes', 'updatedAt']);
      allow delete: if isValidId(ticketId) && isAdmin();
    }

    // =========================================================================
    // MARKET STUDY V1 (market_study_v1) — Hardened Rules
    // =========================================================================

    function isValidFeatureFlag(data, flagId) {
      return data.keys().hasAll([
        'flagId', 'enabled', 'cohortMaxPerLevel', 'rolloutNotes', 'updatedByUid', 'updatedAt'
      ])
      && data.keys().hasOnly([
        'flagId', 'enabled', 'cohortMaxPerLevel', 'rolloutNotes', 'updatedByUid', 'updatedAt'
      ])
      && data.flagId is string && data.flagId == flagId && data.flagId.size() <= 64
      && data.enabled is bool
      && data.cohortMaxPerLevel is number && data.cohortMaxPerLevel >= 1 && data.cohortMaxPerLevel <= 1000
      && data.rolloutNotes is string && data.rolloutNotes.size() <= 240
      && data.updatedByUid is string && data.updatedByUid.size() >= 4 && data.updatedByUid.size() <= 128
      && data.updatedAt is timestamp;
    }

    match /featureFlags/{flagId} {
      allow get: if isValidId(flagId) && isVerifiedUser();
      allow list: if isAdmin();
      allow create, update: if isValidId(flagId)
        && isAdmin()
        && isValidFeatureFlag(incoming(), flagId)
        && incoming().updatedByUid == request.auth.uid
        && incoming().updatedAt == request.time;
      allow delete: if isValidId(flagId) && isAdmin();
    }

    function isValidStudyCohort(data, cohortId) {
      return data.keys().hasAll([
        'level', 'maxQuota', 'currentCount', 'waitlistCount', 'active', 'updatedAt'
      ])
      && data.keys().hasOnly([
        'level', 'maxQuota', 'currentCount', 'waitlistCount', 'active', 'updatedAt'
      ])
      && cohortId in ['fish', 'reg', 'nit']
      && data.level == cohortId
      && data.maxQuota is number && data.maxQuota >= 1 && data.maxQuota <= 1000
      && data.currentCount is number && data.currentCount >= 0 && data.currentCount <= data.maxQuota
      && data.waitlistCount is number && data.waitlistCount >= 0 && data.waitlistCount <= 50000
      && data.active is bool
      && data.updatedAt is timestamp;
    }

    match /studyCohorts/{cohortId} {
      allow get: if isValidId(cohortId) && isVerifiedUser();
      allow list: if isAdmin() || (isVerifiedUser() && existing().level in ['fish', 'reg', 'nit']);
      allow create: if isValidId(cohortId)
        && isValidStudyCohort(incoming(), cohortId)
        && incoming().updatedAt == request.time
        && (
          isAdmin()
          || (
            isVerifiedUser()
            && incoming().maxQuota == 100
            && incoming().currentCount == 1
            && incoming().waitlistCount == 0
            && incoming().active == true
            && existsAfter(/databases/$(database)/documents/studyEnrollments/$(request.auth.uid))
            && getAfter(/databases/$(database)/documents/studyEnrollments/$(request.auth.uid)).data.cohortLevel == cohortId
          )
        );
      allow update: if isValidId(cohortId)
        && isValidStudyCohort(incoming(), cohortId)
        && incoming().updatedAt == request.time
        && (
          isAdmin()
          || (
            isVerifiedUser()
            && existing().active == true
            && incoming().level == existing().level
            && incoming().maxQuota == existing().maxQuota
            && incoming().active == existing().active
            && (
              (
                incoming().currentCount == existing().currentCount + 1
                && incoming().currentCount <= existing().maxQuota
                && incoming().waitlistCount == existing().waitlistCount
                && incoming().diff(existing()).affectedKeys().hasOnly(['currentCount', 'updatedAt'])
                && existsAfter(/databases/$(database)/documents/studyEnrollments/$(request.auth.uid))
                && getAfter(/databases/$(database)/documents/studyEnrollments/$(request.auth.uid)).data.cohortLevel == existing().level
              )
              || (
                existing().currentCount >= existing().maxQuota
                && incoming().currentCount == existing().currentCount
                && incoming().waitlistCount == existing().waitlistCount + 1
                && incoming().diff(existing()).affectedKeys().hasOnly(['waitlistCount', 'updatedAt'])
                && existsAfter(/databases/$(database)/documents/studyEnrollments/$(request.auth.uid))
                && getAfter(/databases/$(database)/documents/studyEnrollments/$(request.auth.uid)).data.status == 'waitlisted'
              )
              || (
                existing().currentCount > 0
                && incoming().currentCount == existing().currentCount - 1
                && incoming().waitlistCount == existing().waitlistCount
                && incoming().diff(existing()).affectedKeys().hasOnly(['currentCount', 'updatedAt'])
                && getAfter(/databases/$(database)/documents/studyEnrollments/$(request.auth.uid)).data.status == 'withdrawn'
              )
            )
          )
        );
      allow delete: if isValidId(cohortId) && isAdmin();
    }

    function isValidStudyConsent(data) {
      return data.keys().hasAll([
        'uid', 'consentVersion', 'accepted', 'isAdult', 'birthYear', 'jurisdiction',
        'ipHash', 'countryCode', 'userAgent', 'status', 'acceptedAt'
      ])
      && data.keys().hasOnly([
        'uid', 'consentVersion', 'accepted', 'isAdult', 'birthYear', 'jurisdiction',
        'ipHash', 'countryCode', 'userAgent', 'status', 'acceptedAt', 'revokedAt'
      ])
      && data.uid is string && data.uid.size() >= 6 && data.uid.size() <= 128
      && data.consentVersion is string && data.consentVersion.size() >= 1 && data.consentVersion.size() <= 16
      && data.accepted is bool
      && data.isAdult is bool
      && data.birthYear is number && data.birthYear >= 1920 && data.birthYear <= 2010
      && data.jurisdiction == 'CO_1581_GDPR'
      && data.ipHash is string && data.ipHash.size() >= 4 && data.ipHash.size() <= 96
      && data.countryCode is string && data.countryCode.size() >= 2 && data.countryCode.size() <= 12
      && data.userAgent is string && data.userAgent.size() <= 200
      && data.status in ['active', 'revoked']
      && data.acceptedAt is timestamp
      && (!data.keys().hasAny(['revokedAt']) || data.revokedAt == null || data.revokedAt is timestamp);
    }

    match /studyConsents/{consentId} {
      allow get: if isValidId(consentId) && (isAdmin() || (isVerifiedUser() && existing().uid == request.auth.uid));
      allow list: if isAdmin() || (isVerifiedUser() && existing().uid == request.auth.uid);
      allow create: if isValidId(consentId)
        && isOwner(incoming().uid)
        && consentId == (request.auth.uid + '_v1_0')
        && isValidStudyConsent(incoming())
        && incoming().accepted == true
        && incoming().isAdult == true
        && incoming().status == 'active'
        && incoming().acceptedAt == request.time;
      allow update: if isValidId(consentId)
        && isValidStudyConsent(incoming())
        && incoming().uid == existing().uid
        && incoming().consentVersion == existing().consentVersion
        && incoming().accepted == existing().accepted
        && incoming().isAdult == existing().isAdult
        && incoming().birthYear == existing().birthYear
        && incoming().acceptedAt == existing().acceptedAt
        && (
          isAdmin()
          || (
            isOwner(existing().uid)
            && existing().status == 'active'
            && incoming().status == 'revoked'
            && incoming().revokedAt == request.time
            && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'revokedAt'])
          )
        );
      allow delete: if false;
    }

    function isValidStudyEnrollment(data, userId) {
      return data.keys().hasAll([
        'uid', 'selfSelectedLevel', 'cohortLevel', 'adminOverrideLevel', 'effectiveLevel',
        'levelSource', 'status', 'consentVersion', 'enrolledAtMs', 'studyEndsAtMs',
        'completedSurveys', 'enrolledAt', 'updatedAt'
      ])
      && data.keys().hasOnly([
        'uid', 'selfSelectedLevel', 'cohortLevel', 'adminOverrideLevel', 'effectiveLevel',
        'levelSource', 'status', 'consentVersion', 'enrolledAtMs', 'studyEndsAtMs',
        'completedSurveys', 'withdrawnAtMs', 'purgeScheduledAtMs', 'enrolledAt', 'updatedAt'
      ])
      && data.uid is string && data.uid.size() >= 6 && data.uid.size() <= 128 && data.uid == userId
      && data.selfSelectedLevel in ['fish', 'reg', 'nit']
      && data.cohortLevel in ['fish', 'reg', 'nit']
      && data.adminOverrideLevel in ['fish', 'reg', 'nit', 'none']
      && data.effectiveLevel in ['fish', 'reg', 'nit']
      && data.levelSource in ['self_selected', 'cohort_assignment', 'admin_override']
      && data.status in ['active', 'waitlisted', 'withdrawn', 'completed']
      && data.consentVersion is string && data.consentVersion.size() >= 1 && data.consentVersion.size() <= 16
      && data.enrolledAtMs is number && data.enrolledAtMs > 0
      && data.studyEndsAtMs is number && data.studyEndsAtMs >= data.enrolledAtMs
      && data.completedSurveys is list && data.completedSurveys.size() <= 8
      && (data.completedSurveys.size() == 0 || (data.completedSurveys[0] is string && data.completedSurveys[0].size() <= 16))
      && (!data.keys().hasAny(['withdrawnAtMs']) || data.withdrawnAtMs is number)
      && (!data.keys().hasAny(['purgeScheduledAtMs']) || data.purgeScheduledAtMs is number)
      && data.enrolledAt is timestamp
      && data.updatedAt is timestamp;
    }

    match /studyEnrollments/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isAdmin() || (isVerifiedUser() && existing().uid == request.auth.uid);
      allow create: if isValidId(userId)
        && isOwner(userId)
        && isValidStudyEnrollment(incoming(), userId)
        && exists(/databases/$(database)/documents/studyConsents/$(userId + '_v1_0'))
        && get(/databases/$(database)/documents/studyConsents/$(userId + '_v1_0')).data.status == 'active'
        && incoming().adminOverrideLevel == 'none'
        && incoming().enrolledAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(userId)
        && isValidStudyEnrollment(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().cohortLevel == existing().cohortLevel
        && incoming().consentVersion == existing().consentVersion
        && incoming().enrolledAt == existing().enrolledAt
        && incoming().updatedAt == request.time
        && (
          isAdmin()
          || (
            isOwner(userId)
            && incoming().adminOverrideLevel == existing().adminOverrideLevel
            && (
              incoming().status == existing().status
              || (existing().status in ['active', 'waitlisted'] && incoming().status == 'withdrawn')
            )
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'selfSelectedLevel', 'effectiveLevel', 'levelSource',
              'completedSurveys', 'status', 'withdrawnAtMs', 'purgeScheduledAtMs', 'updatedAt'
            ])
          )
        );
      allow delete: if isValidId(userId) && isAdmin();
    }

    function isValidStudyEvent(data) {
      return data.keys().hasAll([
        'uid', 'sessionId', 'cohortLevel', 'effectiveLevel', 'eventName',
        'module', 'durationMs', 'metadataJson', 'expiresAtMs', 'createdAt'
      ])
      && data.keys().hasOnly([
        'uid', 'sessionId', 'cohortLevel', 'effectiveLevel', 'eventName',
        'module', 'durationMs', 'metadataJson', 'expiresAtMs', 'createdAt'
      ])
      && data.uid is string && data.uid.size() >= 6 && data.uid.size() <= 128
      && data.sessionId is string && data.sessionId.size() >= 2 && data.sessionId.size() <= 64
      && data.cohortLevel in ['fish', 'reg', 'nit']
      && data.effectiveLevel in ['fish', 'reg', 'nit']
      && data.eventName in [
        'study_enrolled', 'study_withdrawn', 'level_selected', 'tab_viewed',
        'hand_simulated', 'solver_calculated', 'academy_evaluated',
        'tracker2_imported', 'survey_submitted', 'session_heartbeat'
      ]
      && data.module is string && data.module.size() >= 1 && data.module.size() <= 64
      && data.durationMs is number && data.durationMs >= 0 && data.durationMs <= 86400000
      && data.metadataJson is string && data.metadataJson.size() <= 500
      && data.expiresAtMs is number && data.expiresAtMs > 0
      && data.createdAt is timestamp;
    }

    match /studyEvents/{eventId} {
      allow get: if isValidId(eventId) && (isAdmin() || (isVerifiedUser() && existing().uid == request.auth.uid));
      allow list: if isAdmin() || (isVerifiedUser() && existing().uid == request.auth.uid);
      allow create: if isValidId(eventId)
        && isOwner(incoming().uid)
        && isValidStudyEvent(incoming())
        && incoming().createdAt == request.time;
      allow update: if false;
      allow delete: if isValidId(eventId) && (isAdmin() || (isVerifiedUser() && existing().uid == request.auth.uid));
    }

    function isValidStudyFeedback(data) {
      return data.keys().hasAll([
        'uid', 'cohortLevel', 'effectiveLevel', 'milestone', 'npsScore',
        'pmfAnswer', 'levelSatisfaction', 'densityFeedback', 'openComment',
        'expiresAtMs', 'createdAt'
      ])
      && data.keys().hasOnly([
        'uid', 'cohortLevel', 'effectiveLevel', 'milestone', 'npsScore',
        'pmfAnswer', 'levelSatisfaction', 'densityFeedback', 'openComment',
        'expiresAtMs', 'createdAt'
      ])
      && data.uid is string && data.uid.size() >= 6 && data.uid.size() <= 128
      && data.cohortLevel in ['fish', 'reg', 'nit']
      && data.effectiveLevel in ['fish', 'reg', 'nit']
      && data.milestone in ['day7', 'day14', 'day21', 'day30']
      && data.npsScore is number && data.npsScore >= 0 && data.npsScore <= 10
      && data.pmfAnswer in ['very_disappointed', 'somewhat_disappointed', 'not_disappointed']
      && data.levelSatisfaction is number && data.levelSatisfaction >= 1 && data.levelSatisfaction <= 5
      && data.densityFeedback in ['too_simple', 'just_right', 'too_complex']
      && data.openComment is string && data.openComment.size() <= 800
      && data.expiresAtMs is number && data.expiresAtMs > 0
      && data.createdAt is timestamp;
    }

    match /studyFeedback/{feedbackId} {
      allow get: if isValidId(feedbackId) && (isAdmin() || (isVerifiedUser() && existing().uid == request.auth.uid));
      allow list: if isAdmin() || (isVerifiedUser() && existing().uid == request.auth.uid);
      allow create: if isValidId(feedbackId)
        && isOwner(incoming().uid)
        && isValidStudyFeedback(incoming())
        && incoming().createdAt == request.time;
      allow update: if false;
      allow delete: if isValidId(feedbackId) && (isAdmin() || (isVerifiedUser() && existing().uid == request.auth.uid));
    }
  }
}
