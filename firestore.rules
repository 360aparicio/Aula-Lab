rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Pillar 0: Global Default-Deny Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Primitive Helpers
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isVerifiedUser() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isVerifiedUser() && (
        request.auth.token.email == '360aparicio@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        (
          exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' &&
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.planActive == true
        )
      );
    }

    function isValidPlanPermissions(perms) {
      return perms is map
        && perms.keys().hasAll(['labPro', 'webBrain', 'unlimitedEval', 'pdfExport'])
        && perms.keys().hasOnly(['labPro', 'webBrain', 'unlimitedEval', 'pdfExport', 'planAdmin'])
        && perms.labPro is bool
        && perms.webBrain is bool
        && perms.unlimitedEval is bool
        && perms.pdfExport is bool
        && (!perms.keys().hasAny(['planAdmin']) || perms.planAdmin is bool);
    }

    function isValidEmailKey(inviteId) {
      return isVerifiedUser()
        && request.auth.token.email is string
        && inviteId == ('inv_' + request.auth.token.email.lower().replace('[^a-zA-Z0-9_\\-]', '_'));
    }

    function hasValidInviteForCaller() {
      return isVerifiedUser()
        && request.auth.token.email is string
        && exists(/databases/$(database)/documents/userInvites/$( 'inv_' + request.auth.token.email.lower().replace('[^a-zA-Z0-9_\\-]', '_') ))
        && get(/databases/$(database)/documents/userInvites/$( 'inv_' + request.auth.token.email.lower().replace('[^a-zA-Z0-9_\\-]', '_') )).data.status == 'pending'
        && get(/databases/$(database)/documents/userInvites/$( 'inv_' + request.auth.token.email.lower().replace('[^a-zA-Z0-9_\\-]', '_') )).data.email == request.auth.token.email.lower();
    }

    function matchesCallerInvite(data) {
      return hasValidInviteForCaller()
        && data.role == get(/databases/$(database)/documents/userInvites/$( 'inv_' + request.auth.token.email.lower().replace('[^a-zA-Z0-9_\\-]', '_') )).data.role
        && data.planTier == get(/databases/$(database)/documents/userInvites/$( 'inv_' + request.auth.token.email.lower().replace('[^a-zA-Z0-9_\\-]', '_') )).data.planTier
        && data.planActive == get(/databases/$(database)/documents/userInvites/$( 'inv_' + request.auth.token.email.lower().replace('[^a-zA-Z0-9_\\-]', '_') )).data.planActive
        && (!data.keys().hasAny(['planPermissions']) || data.planPermissions == get(/databases/$(database)/documents/userInvites/$( 'inv_' + request.auth.token.email.lower().replace('[^a-zA-Z0-9_\\-]', '_') )).data.planPermissions);
    }

    // Validation Blueprint: UserProfile
    function isValidUserProfile(data, userId) {
      return data.keys().hasAll([
        'uid', 'email', 'displayName', 'role', 'planTier', 'planActive',
        'elo', 'masteryScore', 'totalDecisions', 'totalMistakes',
        'roadmapDoneIds', 'categoryStats', 'evaluationStats', 'createdAt', 'updatedAt'
      ])
      && data.keys().hasOnly([
        'uid', 'email', 'displayName', 'photoURL', 'role', 'planTier', 'planActive', 'planPermissions',
        'isManualPlaceholder', 'elo', 'masteryScore', 'totalDecisions', 'totalMistakes',
        'roadmapDoneIds', 'categoryStats', 'evaluationStats', 'createdAt', 'updatedAt'
      ])
      && data.uid is string && data.uid.size() >= 6 && data.uid.size() <= 128 && data.uid == userId
      && data.email is string && data.email.size() >= 3 && data.email.size() <= 160
      && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 80
      && (!data.keys().hasAny(['photoURL']) || (data.photoURL is string && data.photoURL.size() <= 512))
      && (!data.keys().hasAny(['planPermissions']) || isValidPlanPermissions(data.planPermissions))
      && (!data.keys().hasAny(['isManualPlaceholder']) || data.isManualPlaceholder is bool)
      && data.role in ['user', 'admin']
      && data.planTier in ['free', 'pro', 'elite']
      && data.planActive is bool
      && data.elo is number && data.elo >= 0 && data.elo <= 5000
      && data.masteryScore is number && data.masteryScore >= 0 && data.masteryScore <= 100
      && data.totalDecisions is number && data.totalDecisions >= 0
      && data.totalMistakes is number && data.totalMistakes >= 0
      && data.roadmapDoneIds is list && data.roadmapDoneIds.size() <= 32
      && (data.roadmapDoneIds.size() == 0 || (data.roadmapDoneIds[0] is string && data.roadmapDoneIds[0].size() <= 32))
      && data.categoryStats is map
      && data.evaluationStats is map
      && data.createdAt is timestamp
      && data.updatedAt is timestamp;
    }

    // Validation Blueprint: UserInvite
    function isValidUserInvite(data) {
      return data.keys().hasAll([
        'email', 'displayName', 'role', 'planTier', 'planActive', 'planPermissions',
        'status', 'manualUserDocId', 'createdByUid', 'createdAt', 'updatedAt'
      ])
      && data.keys().hasOnly([
        'email', 'displayName', 'role', 'planTier', 'planActive', 'planPermissions',
        'status', 'manualUserDocId', 'createdByUid', 'claimedUid', 'createdAt', 'updatedAt'
      ])
      && data.email is string && data.email.size() >= 3 && data.email.size() <= 160
      && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 80
      && data.role in ['user', 'admin']
      && data.planTier in ['free', 'pro', 'elite']
      && data.planActive is bool
      && isValidPlanPermissions(data.planPermissions)
      && data.status in ['pending', 'claimed']
      && data.manualUserDocId is string && data.manualUserDocId.size() >= 6 && data.manualUserDocId.size() <= 128
      && data.createdByUid is string && data.createdByUid.size() >= 6 && data.createdByUid.size() <= 128
      && (!data.keys().hasAny(['claimedUid']) || (data.claimedUid is string && data.claimedUid.size() >= 6 && data.claimedUid.size() <= 128))
      && data.createdAt is timestamp
      && data.updatedAt is timestamp;
    }

    // Validation Blueprint: SM2ItemRecord
    function isValidSM2Item(data, userId) {
      return data.keys().hasAll([
        'ownerId', 'itemType', 'title', 'category', 'prompt', 'explanation',
        'rule', 'intervalDays', 'repetitions', 'easeFactor', 'nextReviewDate',
        'reviewCount', 'createdAt', 'updatedAt'
      ])
      && data.keys().hasOnly([
        'ownerId', 'itemType', 'title', 'category', 'prompt', 'explanation',
        'rule', 'intervalDays', 'repetitions', 'easeFactor', 'nextReviewDate',
        'reviewCount', 'createdAt', 'updatedAt'
      ])
      && data.ownerId is string && data.ownerId.size() >= 6 && data.ownerId.size() <= 128
      && data.ownerId == request.auth.uid && data.ownerId == userId
      && data.itemType in ['concept', 'hand', 'scenario']
      && data.title is string && data.title.size() >= 1 && data.title.size() <= 160
      && data.category is string && data.category.size() >= 1 && data.category.size() <= 80
      && data.prompt is string && data.prompt.size() <= 600
      && data.explanation is string && data.explanation.size() <= 1200
      && data.rule is string && data.rule.size() <= 600
      && data.intervalDays is number && data.intervalDays >= 0 && data.intervalDays <= 3650
      && data.repetitions is number && data.repetitions >= 0 && data.repetitions <= 500
      && data.easeFactor is number && data.easeFactor >= 1.3 && data.easeFactor <= 5.0
      && data.nextReviewDate is number && data.nextReviewDate >= 0
      && data.reviewCount is number && data.reviewCount >= 0
      && data.createdAt is timestamp
      && data.updatedAt is timestamp;
    }

    // Validation Blueprint: MistakeRecord
    function isValidMistakeRecord(data, userId) {
      return data.keys().hasAll([
        'ownerId', 'scenarioTitle', 'heroCombo', 'wetness',
        'evLossPercentOfPot', 'chosenAction', 'bestAction', 'prescriptiveFix', 'createdAt'
      ])
      && data.keys().hasOnly([
        'ownerId', 'scenarioTitle', 'heroCombo', 'wetness',
        'evLossPercentOfPot', 'chosenAction', 'bestAction', 'prescriptiveFix', 'createdAt'
      ])
      && data.ownerId is string && data.ownerId.size() >= 6 && data.ownerId.size() <= 128
      && data.ownerId == request.auth.uid && data.ownerId == userId
      && data.scenarioTitle is string && data.scenarioTitle.size() >= 1 && data.scenarioTitle.size() <= 160
      && data.heroCombo is string && data.heroCombo.size() >= 2 && data.heroCombo.size() <= 16
      && data.wetness is string && data.wetness.size() >= 1 && data.wetness.size() <= 48
      && data.evLossPercentOfPot is number && data.evLossPercentOfPot >= 0 && data.evLossPercentOfPot <= 500
      && data.chosenAction is string && data.chosenAction.size() >= 1 && data.chosenAction.size() <= 80
      && data.bestAction is string && data.bestAction.size() >= 1 && data.bestAction.size() <= 80
      && data.prescriptiveFix is string && data.prescriptiveFix.size() >= 1 && data.prescriptiveFix.size() <= 600
      && data.createdAt is timestamp;
    }

    // Admin lookup collection (read-only for owner)
    match /admins/{adminId} {
      allow get: if isValidId(adminId) && isOwner(adminId);
      allow list, write: if false;
    }

    // Admin-provisioned manual user invitations
    match /userInvites/{inviteId} {
      allow get: if isValidId(inviteId) && (isAdmin() || (isValidEmailKey(inviteId) && existing().email == request.auth.token.email.lower()));
      allow list: if isAdmin();
      allow create: if isValidId(inviteId)
        && isAdmin()
        && isValidUserInvite(incoming())
        && incoming().createdByUid == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(inviteId)
        && isValidUserInvite(incoming())
        && incoming().email == existing().email
        && incoming().createdByUid == existing().createdByUid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          isAdmin() || (
            isValidEmailKey(inviteId)
            && existing().status == 'pending'
            && incoming().status == 'claimed'
            && incoming().claimedUid == request.auth.uid
            && incoming().role == existing().role
            && incoming().planTier == existing().planTier
            && incoming().planActive == existing().planActive
            && incoming().planPermissions == existing().planPermissions
            && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'claimedUid', 'updatedAt'])
          )
        );
      allow delete: if isValidId(inviteId) && isAdmin();
    }

    // Match User Profile Collection
    match /users/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isAdmin() || (isVerifiedUser() && existing().uid == request.auth.uid);

      allow create: if isValidId(userId)
        && isValidUserProfile(incoming(), userId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && (
          isAdmin()
          || (
            isOwner(userId)
            && incoming().uid == request.auth.uid
            && !incoming().keys().hasAny(['isManualPlaceholder'])
            && (
              matchesCallerInvite(incoming())
              || (
                incoming().role == 'user'
                && incoming().planTier == 'free'
                && incoming().planActive == true
                && !incoming().keys().hasAny(['planPermissions'])
              )
            )
          )
        );

      allow update: if isValidId(userId)
        && isValidUserProfile(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          // Normal strict V3.2/V3.4 updates (existing doc already has RBAC/plan fields)
          (
            existing().keys().hasAll(['email', 'role', 'planTier', 'planActive', 'evaluationStats'])
            && incoming().email == existing().email
            && (
              // Tier 1: Admin can manage planTier, planActive, planPermissions, role & metrics
              (
                isAdmin()
                && incoming().diff(existing()).affectedKeys().hasOnly([
                  'displayName', 'photoURL', 'role', 'planTier', 'planActive', 'planPermissions',
                  'isManualPlaceholder', 'elo', 'masteryScore', 'totalDecisions', 'totalMistakes',
                  'roadmapDoneIds', 'categoryStats', 'evaluationStats', 'updatedAt'
                ])
              )
              ||
              // Tier 2: Owner can ONLY update own study metrics (cannot forge plan, permissions or role)
              (
                isOwner(userId)
                && incoming().role == existing().role
                && incoming().planTier == existing().planTier
                && incoming().planActive == existing().planActive
                && incoming().diff(existing()).affectedKeys().hasOnly([
                  'displayName', 'photoURL', 'elo', 'masteryScore', 'totalDecisions',
                  'totalMistakes', 'roadmapDoneIds', 'categoryStats', 'evaluationStats', 'updatedAt'
                ])
              )
            )
          )
          ||
          // Safe one-time migration from legacy V3.1 docs missing V3.2 RBAC/plan fields
          (
            !existing().keys().hasAll(['email', 'role', 'planTier', 'planActive', 'evaluationStats'])
            && isOwner(userId)
            && incoming().role == (isAdmin() ? 'admin' : 'user')
            && incoming().planTier == (isAdmin() ? 'elite' : 'free')
            && incoming().planActive == true
          )
        );

      allow delete: if isValidId(userId) && (isOwner(userId) || isAdmin());

      // Subcollection: SM-2 Items
      match /sm2Items/{itemId} {
        allow get: if isValidId(userId) && isValidId(itemId) && (isOwner(userId) || isAdmin());
        allow list: if isAdmin() || (isVerifiedUser() && existing().ownerId == request.auth.uid);

        allow create: if isValidId(userId) && isValidId(itemId)
          && isOwner(userId)
          && exists(/databases/$(database)/documents/users/$(userId))
          && isValidSM2Item(incoming(), userId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time;

        allow update: if isValidId(userId) && isValidId(itemId)
          && isOwner(userId)
          && exists(/databases/$(database)/documents/users/$(userId))
          && isValidSM2Item(incoming(), userId)
          && incoming().ownerId == existing().ownerId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'title', 'category', 'prompt', 'explanation', 'rule',
            'intervalDays', 'repetitions', 'easeFactor', 'nextReviewDate',
            'reviewCount', 'updatedAt'
          ]);

        allow delete: if isValidId(userId) && isValidId(itemId) && (isOwner(userId) || isAdmin());
      }

      // Subcollection: Mistakes (>5% EV)
      match /mistakes/{mistakeId} {
        allow get: if isValidId(userId) && isValidId(mistakeId) && (isOwner(userId) || isAdmin());
        allow list: if isAdmin() || (isVerifiedUser() && existing().ownerId == request.auth.uid);

        allow create: if isValidId(userId) && isValidId(mistakeId)
          && isOwner(userId)
          && exists(/databases/$(database)/documents/users/$(userId))
          && isValidMistakeRecord(incoming(), userId)
          && incoming().createdAt == request.time;

        allow update: if false;
        allow delete: if isValidId(userId) && isValidId(mistakeId) && (isOwner(userId) || isAdmin());
      }
    }

    // Validation Blueprint: AdminAuditLog
    function isValidAdminAuditLog(data) {
      return data.keys().hasAll([
        'actorUid', 'actorEmail', 'targetUid', 'targetLabel', 'action', 'detail', 'createdAt'
      ])
      && data.keys().hasOnly([
        'actorUid', 'actorEmail', 'targetUid', 'targetLabel', 'action', 'detail', 'createdAt'
      ])
      && data.actorUid is string && data.actorUid.size() >= 6 && data.actorUid.size() <= 128
      && data.actorEmail is string && data.actorEmail.size() >= 3 && data.actorEmail.size() <= 160
      && data.targetUid is string && data.targetUid.size() >= 6 && data.targetUid.size() <= 128
      && data.targetLabel is string && data.targetLabel.size() >= 1 && data.targetLabel.size() <= 160
      && data.action is string && data.action.size() >= 2 && data.action.size() <= 64
      && data.detail is string && data.detail.size() >= 1 && data.detail.size() <= 300
      && data.createdAt is timestamp;
    }

    // Immutable Admin Audit Log Collection
    match /adminAuditLogs/{logId} {
      allow get, list: if isAdmin();
      allow create: if isValidId(logId)
        && isAdmin()
        && isValidAdminAuditLog(incoming())
        && incoming().actorUid == request.auth.uid
        && incoming().createdAt == request.time;
      allow update, delete: if false;
    }
  }
}
