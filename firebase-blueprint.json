{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Private 6-Max NLHE student profile, subscription plan state, evaluation scores, ELO rating, mastery metrics and career roadmap progress.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Firebase Auth UID of the user",
          "minLength": 6,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "email": {
          "type": "string",
          "description": "Verified user email address",
          "minLength": 3,
          "maxLength": 160
        },
        "displayName": {
          "type": "string",
          "description": "Player display name",
          "minLength": 1,
          "maxLength": 80
        },
        "photoURL": {
          "type": "string",
          "description": "Optional avatar URL",
          "maxLength": 512
        },
        "role": {
          "type": "string",
          "enum": ["user", "admin"],
          "maxLength": 16
        },
        "planTier": {
          "type": "string",
          "enum": ["free", "pro", "elite"],
          "maxLength": 16
        },
        "planActive": {
          "type": "boolean",
          "description": "Whether the user's plan access is enabled by administration"
        },
        "planPermissions": {
          "type": "object",
          "description": "Optional per-user granular subscription permissions (labPro, webBrain, unlimitedEval, pdfExport, planAdmin)"
        },
        "isManualPlaceholder": {
          "type": "boolean",
          "description": "True when created manually by an administrator prior to the user's first Google sign-in"
        },
        "elo": {
          "type": "number",
          "description": "Current GTO trainer ELO score"
        },
        "masteryScore": {
          "type": "number",
          "description": "Overall mastery score from 0 to 100"
        },
        "totalDecisions": {
          "type": "number",
          "description": "Total recorded strategic decisions"
        },
        "totalMistakes": {
          "type": "number",
          "description": "Total mistakes above threshold"
        },
        "roadmapDoneIds": {
          "type": "array",
          "description": "Completed Career Roadmap milestone IDs (max 32)"
        },
        "categoryStats": {
          "type": "object",
          "description": "Map of category accuracy counters"
        },
        "evaluationStats": {
          "type": "object",
          "description": "Latest and best evaluation exam scores across fixed and variable spot modules"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server last update timestamp"
        }
      },
      "required": [
        "uid", "email", "displayName", "role", "planTier", "planActive",
        "elo", "masteryScore", "totalDecisions", "totalMistakes",
        "roadmapDoneIds", "categoryStats", "evaluationStats", "createdAt", "updatedAt"
      ]
    },
    "UserInvite": {
      "title": "UserInvite",
      "description": "Admin-provisioned manual user invitation binding a verified email to pre-assigned plan, active state, role, and granular permissions.",
      "type": "object",
      "properties": {
        "email": {
          "type": "string",
          "minLength": 3,
          "maxLength": 160
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "role": {
          "type": "string",
          "enum": ["user", "admin"],
          "maxLength": 16
        },
        "planTier": {
          "type": "string",
          "enum": ["free", "pro", "elite"],
          "maxLength": 16
        },
        "planActive": {
          "type": "boolean"
        },
        "planPermissions": {
          "type": "object",
          "description": "Granular plan permissions (labPro, webBrain, unlimitedEval, pdfExport, planAdmin)"
        },
        "status": {
          "type": "string",
          "enum": ["pending", "claimed"],
          "maxLength": 16
        },
        "manualUserDocId": {
          "type": "string",
          "minLength": 6,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "createdByUid": {
          "type": "string",
          "minLength": 6,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "claimedUid": {
          "type": "string",
          "minLength": 6,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "email", "displayName", "role", "planTier", "planActive", "planPermissions",
        "status", "manualUserDocId", "createdByUid", "createdAt", "updatedAt"
      ]
    },
    "SM2ItemRecord": {
      "title": "SM2ItemRecord",
      "description": "Individual SuperMemo SM-2 spaced repetition item belonging to a user.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "minLength": 6,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "itemType": {
          "type": "string",
          "enum": ["concept", "hand", "scenario"],
          "maxLength": 24
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "category": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "prompt": {
          "type": "string",
          "maxLength": 600
        },
        "explanation": {
          "type": "string",
          "maxLength": 1200
        },
        "rule": {
          "type": "string",
          "maxLength": 600
        },
        "intervalDays": {
          "type": "number"
        },
        "repetitions": {
          "type": "number"
        },
        "easeFactor": {
          "type": "number"
        },
        "nextReviewDate": {
          "type": "number"
        },
        "reviewCount": {
          "type": "number"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["ownerId", "itemType", "title", "category", "prompt", "explanation", "rule", "intervalDays", "repetitions", "easeFactor", "nextReviewDate", "reviewCount", "createdAt", "updatedAt"]
    },
    "MistakeRecord": {
      "title": "MistakeRecord",
      "description": "Captured EV loss (>5% EV threshold) mistake with board texture and prescriptive fix.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "minLength": 6,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "scenarioTitle": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "heroCombo": {
          "type": "string",
          "minLength": 2,
          "maxLength": 16
        },
        "wetness": {
          "type": "string",
          "minLength": 1,
          "maxLength": 48
        },
        "evLossPercentOfPot": {
          "type": "number"
        },
        "chosenAction": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "bestAction": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "prescriptiveFix": {
          "type": "string",
          "minLength": 1,
          "maxLength": 600
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["ownerId", "scenarioTitle", "heroCombo", "wetness", "evLossPercentOfPot", "chosenAction", "bestAction", "prescriptiveFix", "createdAt"]
    },
    "AdminAuditLog": {
      "title": "AdminAuditLog",
      "description": "Immutable administrative audit trail recording plan activations, tier changes, manual user creation, and RBAC updates.",
      "type": "object",
      "properties": {
        "actorUid": {
          "type": "string",
          "minLength": 6,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "actorEmail": {
          "type": "string",
          "minLength": 3,
          "maxLength": 160
        },
        "targetUid": {
          "type": "string",
          "minLength": 6,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "targetLabel": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "action": {
          "type": "string",
          "minLength": 2,
          "maxLength": 64
        },
        "detail": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["actorUid", "actorEmail", "targetUid", "targetLabel", "action", "detail", "createdAt"]
    },
    "PlanConfig": {
      "title": "PlanConfig",
      "description": "Admin-managed subscription tier configuration controlling visible Educational Lab sections, benefits copy, daily evaluation limits, and default permissions.",
      "type": "object",
      "properties": {
        "planTier": {
          "type": "string",
          "enum": ["free", "pro", "elite"],
          "maxLength": 16
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 48
        },
        "tagline": {
          "type": "string",
          "maxLength": 160
        },
        "priceLabel": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32
        },
        "maxDailyEvaluations": {
          "type": "number"
        },
        "hideLockedSections": {
          "type": "boolean"
        },
        "visibleSections": {
          "type": "object",
          "description": "Map of Educational Lab tabs (wizard, solver, trainer, cheatsheet, academy, solver_meta, ranges, scenarios, benchmarks) enabled for this plan"
        },
        "defaultPermissions": {
          "type": "object",
          "description": "Default granular permissions (labPro, webBrain, unlimitedEval, pdfExport, planAdmin)"
        },
        "benefits": {
          "type": "array",
          "description": "List of user-facing benefit strings for this tier (max 15)"
        },
        "updatedByUid": {
          "type": "string",
          "minLength": 6,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "planTier", "displayName", "tagline", "priceLabel",
        "maxDailyEvaluations", "hideLockedSections", "visibleSections",
        "defaultPermissions", "benefits", "updatedByUid", "updatedAt"
      ]
    },
    "BillingTransaction": {
      "title": "BillingTransaction",
      "description": "Subscription payment, manual invoice, renewal, or refund ledger entry recorded in Admin Console.",
      "type": "object",
      "properties": {
        "userUid": {
          "type": "string",
          "minLength": 4,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "userEmail": {
          "type": "string",
          "minLength": 3,
          "maxLength": 160
        },
        "userName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "planTier": {
          "type": "string",
          "enum": ["free", "pro", "elite"],
          "maxLength": 16
        },
        "amountUsd": {
          "type": "number"
        },
        "currency": {
          "type": "string",
          "enum": ["USD"],
          "maxLength": 8
        },
        "paymentMethod": {
          "type": "string",
          "enum": ["Stripe", "Transferencia", "PayPal", "Efectivo", "Cortesía"],
          "maxLength": 32
        },
        "status": {
          "type": "string",
          "enum": ["paid", "pending", "refunded"],
          "maxLength": 16
        },
        "billingPeriod": {
          "type": "string",
          "minLength": 7,
          "maxLength": 16
        },
        "referenceCode": {
          "type": "string",
          "maxLength": 64
        },
        "notes": {
          "type": "string",
          "maxLength": 240
        },
        "recordedByUid": {
          "type": "string",
          "minLength": 6,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "userUid", "userEmail", "userName", "planTier", "amountUsd", "currency",
        "paymentMethod", "status", "billingPeriod", "referenceCode", "notes",
        "recordedByUid", "createdAt", "updatedAt"
      ]
    },
    "PlatformAnnouncement": {
      "title": "PlatformAnnouncement",
      "description": "Live platform-wide notice or banner published from Admin Console to students in Educational Lab.",
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "minLength": 2,
          "maxLength": 90
        },
        "message": {
          "type": "string",
          "minLength": 4,
          "maxLength": 300
        },
        "severity": {
          "type": "string",
          "enum": ["info", "success", "warning"],
          "maxLength": 16
        },
        "targetPlan": {
          "type": "string",
          "enum": ["all", "free", "pro", "elite"],
          "maxLength": 16
        },
        "active": {
          "type": "boolean"
        },
        "createdByUid": {
          "type": "string",
          "minLength": 6,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "title", "message", "severity", "targetPlan", "active",
        "createdByUid", "createdAt", "updatedAt"
      ]
    },
    "SupportTicket": {
      "title": "SupportTicket",
      "description": "Student support request or internal admin account follow-up ticket.",
      "type": "object",
      "properties": {
        "userUid": {
          "type": "string",
          "minLength": 4,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "userEmail": {
          "type": "string",
          "minLength": 3,
          "maxLength": 160
        },
        "userName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "subject": {
          "type": "string",
          "minLength": 2,
          "maxLength": 120
        },
        "description": {
          "type": "string",
          "minLength": 4,
          "maxLength": 600
        },
        "category": {
          "type": "string",
          "enum": ["Acceso", "Pagos", "Duda Técnica", "Otro"],
          "maxLength": 32
        },
        "priority": {
          "type": "string",
          "enum": ["low", "medium", "high"],
          "maxLength": 16
        },
        "status": {
          "type": "string",
          "enum": ["open", "in_progress", "resolved"],
          "maxLength": 16
        },
        "adminNotes": {
          "type": "string",
          "maxLength": 400
        },
        "createdByUid": {
          "type": "string",
          "minLength": 6,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "userUid", "userEmail", "userName", "subject", "description",
        "category", "priority", "status", "adminNotes", "createdByUid",
        "createdAt", "updatedAt"
      ]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Owner & Admin readable student profile including plan tier, active status, evaluation metrics & level, ELO, category stats, and career roadmap milestones."
    },
    "/userInvites/{inviteId}": {
      "schema": { "$ref": "#/entities/UserInvite" },
      "description": "Admin-provisioned user provisioning records keyed deterministically from email for first-login claim."
    },
    "/planConfigs/{planTier}": {
      "schema": { "$ref": "#/entities/PlanConfig" },
      "description": "Admin-managed plan catalog configuring Educational Lab visible sections, benefits list, and default permissions for free/pro/elite."
    },
    "/billingTransactions/{txId}": {
      "schema": { "$ref": "#/entities/BillingTransaction" },
      "description": "Subscription revenue, payments, renewals, and refunds recorded by Admin Console."
    },
    "/platformAnnouncements/{annId}": {
      "schema": { "$ref": "#/entities/PlatformAnnouncement" },
      "description": "Live platform announcements targeted to students by plan tier."
    },
    "/supportTickets/{ticketId}": {
      "schema": { "$ref": "#/entities/SupportTicket" },
      "description": "Student support requests and internal administrative resolution notes."
    },
    "/users/{userId}/sm2Items/{itemId}": {
      "schema": { "$ref": "#/entities/SM2ItemRecord" },
      "description": "User's private SuperMemo SM-2 spaced repetition deck items."
    },
    "/users/{userId}/mistakes/{mistakeId}": {
      "schema": { "$ref": "#/entities/MistakeRecord" },
      "description": "User's private captured >5% EV loss mistakes and board texture leaks."
    },
    "/adminAuditLogs/{logId}": {
      "schema": { "$ref": "#/entities/AdminAuditLog" },
      "description": "Admin-only immutable audit logs of plan and role management actions."
    }
  }
}
