{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Private 6-Max NLHE student profile, subscription plan state, evaluation scores, ELO rating, mastery metrics and career roadmap progress.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Firebase Auth UID of the user",
          "minLength": 6,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "email": {
          "type": "string",
          "description": "Verified user email address",
          "minLength": 3,
          "maxLength": 160
        },
        "displayName": {
          "type": "string",
          "description": "Player display name",
          "minLength": 1,
          "maxLength": 80
        },
        "photoURL": {
          "type": "string",
          "description": "Optional avatar URL",
          "maxLength": 512
        },
        "role": {
          "type": "string",
          "enum": ["user", "admin"],
          "maxLength": 16
        },
        "planTier": {
          "type": "string",
          "enum": ["free", "pro", "elite"],
          "maxLength": 16
        },
        "planActive": {
          "type": "boolean",
          "description": "Whether the user's plan access is enabled by administration"
        },
        "planPermissions": {
          "type": "object",
          "description": "Optional per-user granular subscription permissions (labPro, webBrain, unlimitedEval, pdfExport, planAdmin)"
        },
        "isManualPlaceholder": {
          "type": "boolean",
          "description": "True when created manually by an administrator prior to the user's first Google sign-in"
        },
        "elo": {
          "type": "number",
          "description": "Current GTO trainer ELO score"
        },
        "masteryScore": {
          "type": "number",
          "description": "Overall mastery score from 0 to 100"
        },
        "totalDecisions": {
          "type": "number",
          "description": "Total recorded strategic decisions"
        },
        "totalMistakes": {
          "type": "number",
          "description": "Total mistakes above threshold"
        },
        "roadmapDoneIds": {
          "type": "array",
          "description": "Completed Career Roadmap milestone IDs (max 32)"
        },
        "categoryStats": {
          "type": "object",
          "description": "Map of category accuracy counters"
        },
        "evaluationStats": {
          "type": "object",
          "description": "Latest and best evaluation exam scores across fixed and variable spot modules"
        },
        "studyLevel": {
          "type": "string",
          "enum": ["fish", "reg", "nit"],
          "maxLength": 8,
          "description": "Optional active Market Study density level when market_study_v1 is enabled"
        },
        "studyLevelSource": {
          "type": "string",
          "enum": ["self_selected", "cohort_assignment", "admin_override"],
          "maxLength": 24,
          "description": "Provenance of studyLevel following admin_override > cohort_assignment > self_selected"
        },
        "marketStudyEnrolled": {
          "type": "boolean",
          "description": "Optional flag indicating active participation in the 30-day market study"
        },
        "deckTheme": {
          "type": "string",
          "enum": ["classic_white", "four_color_white", "dark_pro", "four_color_dark"],
          "maxLength": 24,
          "description": "Selected global playing card deck theme (defaults to classic_white)"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server last update timestamp"
        }
      },
      "required": [
        "uid", "email", "displayName", "role", "planTier", "planActive",
        "elo", "masteryScore", "totalDecisions", "totalMistakes",
        "roadmapDoneIds", "categoryStats", "evaluationStats", "createdAt", "updatedAt"
      ]
    },
    "UserInvite": {
      "title": "UserInvite",
      "description": "Admin-provisioned manual user invitation binding a verified email to pre-assigned plan, active state, role, and granular permissions.",
      "type": "object",
      "properties": {
        "email": {
          "type": "string",
          "minLength": 3,
          "maxLength": 160
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "role": {
          "type": "string",
          "enum": ["user", "admin"],
          "maxLength": 16
        },
        "planTier": {
          "type": "string",
          "enum": ["free", "pro", "elite"],
          "maxLength": 16
        },
        "planActive": {
          "type": "boolean"
        },
        "planPermissions": {
          "type": "object",
          "description": "Granular plan permissions (labPro, webBrain, unlimitedEval, pdfExport, planAdmin)"
        },
        "status": {
          "type": "string",
          "enum": ["pending", "claimed"],
          "maxLength": 16
        },
        "manualUserDocId": {
          "type": "string",
          "minLength": 6,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "createdByUid": {
          "type": "string",
          "minLength": 6,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "claimedUid": {
          "type": "string",
          "minLength": 6,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "email", "displayName", "role", "planTier", "planActive", "planPermissions",
        "status", "manualUserDocId", "createdByUid", "createdAt", "updatedAt"
      ]
    },
    "SM2ItemRecord": {
      "title": "SM2ItemRecord",
      "description": "Individual SuperMemo SM-2 spaced repetition item belonging to a user.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "minLength": 6,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "itemType": {
          "type": "string",
          "enum": ["concept", "hand", "scenario"],
          "maxLength": 24
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "category": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "prompt": {
          "type": "string",
          "maxLength": 600
        },
        "explanation": {
          "type": "string",
          "maxLength": 1200
        },
        "rule": {
          "type": "string",
          "maxLength": 600
        },
        "intervalDays": {
          "type": "number"
        },
        "repetitions": {
          "type": "number"
        },
        "easeFactor": {
          "type": "number"
        },
        "nextReviewDate": {
          "type": "number"
        },
        "reviewCount": {
          "type": "number"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["ownerId", "itemType", "title", "category", "prompt", "explanation", "rule", "intervalDays", "repetitions", "easeFactor", "nextReviewDate", "reviewCount", "createdAt", "updatedAt"]
    },
    "MistakeRecord": {
      "title": "MistakeRecord",
      "description": "Captured EV loss (>5% EV threshold) mistake with board texture and prescriptive fix.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "minLength": 6,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "scenarioTitle": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "heroCombo": {
          "type": "string",
          "minLength": 2,
          "maxLength": 16
        },
        "wetness": {
          "type": "string",
          "minLength": 1,
          "maxLength": 48
        },
        "evLossPercentOfPot": {
          "type": "number"
        },
        "chosenAction": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "bestAction": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "prescriptiveFix": {
          "type": "string",
          "minLength": 1,
          "maxLength": 600
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["ownerId", "scenarioTitle", "heroCombo", "wetness", "evLossPercentOfPot", "chosenAction", "bestAction", "prescriptiveFix", "createdAt"]
    },
    "AdminAuditLog": {
      "title": "AdminAuditLog",
      "description": "Immutable administrative audit trail recording plan activations, tier changes, manual user creation, and RBAC updates.",
      "type": "object",
      "properties": {
        "actorUid": {
          "type": "string",
          "minLength": 6,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "actorEmail": {
          "type": "string",
          "minLength": 3,
          "maxLength": 160
        },
        "targetUid": {
          "type": "string",
          "minLength": 6,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "targetLabel": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "action": {
          "type": "string",
          "minLength": 2,
          "maxLength": 64
        },
        "detail": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["actorUid", "actorEmail", "targetUid", "targetLabel", "action", "detail", "createdAt"]
    },
    "PlanConfig": {
      "title": "PlanConfig",
      "description": "Admin-managed subscription tier configuration controlling visible Educational Lab sections, benefits copy, daily evaluation limits, and default permissions.",
      "type": "object",
      "properties": {
        "planTier": {
          "type": "string",
          "enum": ["free", "pro", "elite"],
          "maxLength": 16
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 48
        },
        "tagline": {
          "type": "string",
          "maxLength": 160
        },
        "priceLabel": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32
        },
        "maxDailyEvaluations": {
          "type": "number"
        },
        "hideLockedSections": {
          "type": "boolean"
        },
        "visibleSections": {
          "type": "object",
          "description": "Map of Educational Lab tabs (wizard, solver, trainer, cheatsheet, academy, solver_meta, ranges, scenarios, benchmarks) enabled for this plan"
        },
        "defaultPermissions": {
          "type": "object",
          "description": "Default granular permissions (labPro, webBrain, unlimitedEval, pdfExport, planAdmin)"
        },
        "benefits": {
          "type": "array",
          "description": "List of user-facing benefit strings for this tier (max 15)"
        },
        "updatedByUid": {
          "type": "string",
          "minLength": 6,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "planTier", "displayName", "tagline", "priceLabel",
        "maxDailyEvaluations", "hideLockedSections", "visibleSections",
        "defaultPermissions", "benefits", "updatedByUid", "updatedAt"
      ]
    },
    "BillingTransaction": {
      "title": "BillingTransaction",
      "description": "Subscription payment, manual invoice, renewal, or refund ledger entry recorded in Admin Console.",
      "type": "object",
      "properties": {
        "userUid": {
          "type": "string",
          "minLength": 4,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "userEmail": {
          "type": "string",
          "minLength": 3,
          "maxLength": 160
        },
        "userName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "planTier": {
          "type": "string",
          "enum": ["free", "pro", "elite"],
          "maxLength": 16
        },
        "amountUsd": {
          "type": "number"
        },
        "currency": {
          "type": "string",
          "enum": ["USD"],
          "maxLength": 8
        },
        "paymentMethod": {
          "type": "string",
          "enum": ["Stripe", "Transferencia", "PayPal", "Efectivo", "Cortesía"],
          "maxLength": 32
        },
        "status": {
          "type": "string",
          "enum": ["paid", "pending", "refunded"],
          "maxLength": 16
        },
        "billingPeriod": {
          "type": "string",
          "minLength": 7,
          "maxLength": 16
        },
        "referenceCode": {
          "type": "string",
          "maxLength": 64
        },
        "notes": {
          "type": "string",
          "maxLength": 240
        },
        "recordedByUid": {
          "type": "string",
          "minLength": 6,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "userUid", "userEmail", "userName", "planTier", "amountUsd", "currency",
        "paymentMethod", "status", "billingPeriod", "referenceCode", "notes",
        "recordedByUid", "createdAt", "updatedAt"
      ]
    },
    "PlatformAnnouncement": {
      "title": "PlatformAnnouncement",
      "description": "Live platform-wide notice or banner published from Admin Console to students in Educational Lab.",
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "minLength": 2,
          "maxLength": 90
        },
        "message": {
          "type": "string",
          "minLength": 4,
          "maxLength": 300
        },
        "severity": {
          "type": "string",
          "enum": ["info", "success", "warning"],
          "maxLength": 16
        },
        "targetPlan": {
          "type": "string",
          "enum": ["all", "free", "pro", "elite"],
          "maxLength": 16
        },
        "active": {
          "type": "boolean"
        },
        "createdByUid": {
          "type": "string",
          "minLength": 6,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "title", "message", "severity", "targetPlan", "active",
        "createdByUid", "createdAt", "updatedAt"
      ]
    },
    "SupportTicket": {
      "title": "SupportTicket",
      "description": "Student support request or internal admin account follow-up ticket.",
      "type": "object",
      "properties": {
        "userUid": {
          "type": "string",
          "minLength": 4,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "userEmail": {
          "type": "string",
          "minLength": 3,
          "maxLength": 160
        },
        "userName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "subject": {
          "type": "string",
          "minLength": 2,
          "maxLength": 120
        },
        "description": {
          "type": "string",
          "minLength": 4,
          "maxLength": 600
        },
        "category": {
          "type": "string",
          "enum": ["Acceso", "Pagos", "Duda Técnica", "Otro"],
          "maxLength": 32
        },
        "priority": {
          "type": "string",
          "enum": ["low", "medium", "high"],
          "maxLength": 16
        },
        "status": {
          "type": "string",
          "enum": ["open", "in_progress", "resolved"],
          "maxLength": 16
        },
        "adminNotes": {
          "type": "string",
          "maxLength": 400
        },
        "createdByUid": {
          "type": "string",
          "minLength": 6,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "userUid", "userEmail", "userName", "subject", "description",
        "category", "priority", "status", "adminNotes", "createdByUid",
        "createdAt", "updatedAt"
      ]
    },
    "FeatureFlag": {
      "title": "FeatureFlag",
      "description": "Runtime feature flag configuration (default OFF for market_study_v1) managed by Admin Console.",
      "type": "object",
      "properties": {
        "flagId": { "type": "string", "minLength": 2, "maxLength": 64, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "enabled": { "type": "boolean" },
        "cohortMaxPerLevel": { "type": "number" },
        "rolloutNotes": { "type": "string", "maxLength": 240 },
        "updatedByUid": { "type": "string", "minLength": 4, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["flagId", "enabled", "cohortMaxPerLevel", "rolloutNotes", "updatedByUid", "updatedAt"]
    },
    "StudyCohort": {
      "title": "StudyCohort",
      "description": "Atomic 100-seat cohort quota counter per study level (fish, reg, nit).",
      "type": "object",
      "properties": {
        "level": { "type": "string", "enum": ["fish", "reg", "nit"], "maxLength": 8 },
        "maxQuota": { "type": "number" },
        "currentCount": { "type": "number" },
        "waitlistCount": { "type": "number" },
        "active": { "type": "boolean" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["level", "maxQuota", "currentCount", "waitlistCount", "active", "updatedAt"]
    },
    "StudyConsent": {
      "title": "StudyConsent",
      "description": "Append-only legal consent and >=18 verification audit record (Law 1581/2012 + GDPR, 5-year retention).",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 6, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "consentVersion": { "type": "string", "minLength": 1, "maxLength": 16 },
        "accepted": { "type": "boolean" },
        "isAdult": { "type": "boolean" },
        "birthYear": { "type": "number" },
        "jurisdiction": { "type": "string", "enum": ["CO_1581_GDPR"], "maxLength": 24 },
        "ipHash": { "type": "string", "minLength": 4, "maxLength": 96 },
        "countryCode": { "type": "string", "minLength": 2, "maxLength": 12 },
        "userAgent": { "type": "string", "maxLength": 200 },
        "status": { "type": "string", "enum": ["active", "revoked"], "maxLength": 16 },
        "acceptedAt": { "type": "string", "format": "date-time" },
        "revokedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "consentVersion", "accepted", "isAdult", "birthYear", "jurisdiction", "ipHash", "countryCode", "userAgent", "status", "acceptedAt"]
    },
    "StudyEnrollment": {
      "title": "StudyEnrollment",
      "description": "Participant cohort assignment, level resolution provenance, and withdrawal status.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 6, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "selfSelectedLevel": { "type": "string", "enum": ["fish", "reg", "nit"], "maxLength": 8 },
        "cohortLevel": { "type": "string", "enum": ["fish", "reg", "nit"], "maxLength": 8 },
        "adminOverrideLevel": { "type": "string", "enum": ["fish", "reg", "nit", "none"], "maxLength": 8 },
        "effectiveLevel": { "type": "string", "enum": ["fish", "reg", "nit"], "maxLength": 8 },
        "levelSource": { "type": "string", "enum": ["self_selected", "cohort_assignment", "admin_override"], "maxLength": 24 },
        "status": { "type": "string", "enum": ["active", "waitlisted", "withdrawn", "completed"], "maxLength": 16 },
        "consentVersion": { "type": "string", "minLength": 1, "maxLength": 16 },
        "enrolledAtMs": { "type": "number" },
        "studyEndsAtMs": { "type": "number" },
        "completedSurveys": { "type": "array" },
        "withdrawnAtMs": { "type": "number" },
        "purgeScheduledAtMs": { "type": "number" },
        "enrolledAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "selfSelectedLevel", "cohortLevel", "adminOverrideLevel", "effectiveLevel", "levelSource", "status", "consentVersion", "enrolledAtMs", "studyEndsAtMs", "completedSurveys", "enrolledAt", "updatedAt"]
    },
    "StudyEvent": {
      "title": "StudyEvent",
      "description": "PII-free batched market study interaction telemetry event (6-month retention).",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 6, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "sessionId": { "type": "string", "minLength": 2, "maxLength": 64 },
        "cohortLevel": { "type": "string", "enum": ["fish", "reg", "nit"], "maxLength": 8 },
        "effectiveLevel": { "type": "string", "enum": ["fish", "reg", "nit"], "maxLength": 8 },
        "eventName": { "type": "string", "minLength": 2, "maxLength": 48 },
        "module": { "type": "string", "minLength": 1, "maxLength": 64 },
        "durationMs": { "type": "number" },
        "metadataJson": { "type": "string", "maxLength": 500 },
        "expiresAtMs": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "sessionId", "cohortLevel", "effectiveLevel", "eventName", "module", "durationMs", "metadataJson", "expiresAtMs", "createdAt"]
    },
    "StudyFeedback": {
      "title": "StudyFeedback",
      "description": "Milestone NPS/PMF and density satisfaction survey (Days 7/14/21/30, 12-month retention).",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 6, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "cohortLevel": { "type": "string", "enum": ["fish", "reg", "nit"], "maxLength": 8 },
        "effectiveLevel": { "type": "string", "enum": ["fish", "reg", "nit"], "maxLength": 8 },
        "milestone": { "type": "string", "enum": ["day7", "day14", "day21", "day30"], "maxLength": 16 },
        "npsScore": { "type": "number" },
        "pmfAnswer": { "type": "string", "enum": ["very_disappointed", "somewhat_disappointed", "not_disappointed"], "maxLength": 32 },
        "levelSatisfaction": { "type": "number" },
        "densityFeedback": { "type": "string", "enum": ["too_simple", "just_right", "too_complex"], "maxLength": 24 },
        "openComment": { "type": "string", "maxLength": 800 },
        "expiresAtMs": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "cohortLevel", "effectiveLevel", "milestone", "npsScore", "pmfAnswer", "levelSatisfaction", "densityFeedback", "openComment", "expiresAtMs", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Owner & Admin readable student profile including plan tier, active status, evaluation metrics & level, ELO, category stats, and career roadmap milestones."
    },
    "/userInvites/{inviteId}": {
      "schema": { "$ref": "#/entities/UserInvite" },
      "description": "Admin-provisioned user provisioning records keyed deterministically from email for first-login claim."
    },
    "/planConfigs/{planTier}": {
