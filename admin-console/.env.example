# GEMINI_API_KEY: Opcional para sincronizar tendencias web desde Admin
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# PORT: Puerto del servidor Express independiente del Admin (4000 por defecto)
PORT=4000

# VITE_LAB_APP_URL: URL pública del Repositorio Educativo (Aula/Lab) para cruzar enlaces
# Ejemplo en producción separada: https://aula.tudominio.com
# Por defecto apunta a / cuando se co-hospeda bajo /admin/
VITE_LAB_APP_URL="/"
